# Servidor
PORT=4000
NODE_ENV=development
# Não usar o nome BASE_URL — Vite/Vitest reserva esse nome e injeta seu próprio valor.
APP_BASE_URL=http://localhost:4000

# Banco de dados
DATABASE_URL="postgresql://botops:botops@localhost:5433/botops"

# JWT (RS256) — gere com: npm run keys:generate (na raiz do monorepo)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# WhatsApp (Baileys) — usado para o canal de alerta WHATSAPP
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_DIR=./whatsapp-sessions

# Detecção de queda
# Um bot é considerado OFFLINE quando fica sem heartbeat por
# heartbeatIntervalSeconds (configurado por bot) x essa margem.
HEARTBEAT_GRACE_MULTIPLIER=3
DOWN_DETECTION_CRON=* * * * *
CRON_TZ=America/Recife
